# Copie ce fichier en .env.local et remplis les valeurs. Ne commite jamais .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://zkmaetegstjnyayhdqkb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret : serveur uniquement (Server Actions, webhooks, crons, scripts).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers > API keys). Clés de test sk_test_ / pk_test_ en développement.
STRIPE_SECRET_KEY=
# Fourni par `stripe listen` en local, ou par l'endpoint du dashboard en production.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM="Nonante <bonjour@exemple.fr>"

# Protège les routes cron. Sert aussi de clé HMAC pour l'empreinte IP de la limitation de débit.
# Générer avec : openssl rand -hex 32
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (phase 8). Générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bonjour@exemple.fr

# Mise sur soi (phase 10) : reste désactivée.
FEATURE_STAKE=false
DEFAULT_STAKE_CENTS=3000

# Part des validations à preuve faible qui déclenchent un contrôle (phase 6).
AUDIT_RATE=0.10
